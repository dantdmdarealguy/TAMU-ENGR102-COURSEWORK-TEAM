import math
# Input x value and tolerences
x_value = float(input("Enter a value for x: "))
# Loop so Input can be posisitive from user
while x_value <= 0 or x_value > 2:
    x_value = float(input("Out of range! Try again: "))
tol = float(input("Enter the tolerance: "))
approx = 0
n = 1
term = ((x_value - 1) ** n) / n
while abs(term) >= tol:
    if n % 2 == 0:
        approx -= term
    else:
        approx += term
    n += 1
    term = ((x_value - 1) ** n) / n
actual = math.log(x_value)
difference = abs(actual - approx)
print(f"ln({x_value}) is approximately {float(approx)}")
print(f"ln({x_value}) is exactly {actual}")
print(f"The difference is {difference}")
