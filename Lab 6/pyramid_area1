# Prompt the user to input the side length of a cube in meters and the number of layers
sl=float(input("Enter the side length in meters: "))
lay=float(input("Enter the number of layers: "))
# Create a loop to calculate the total surface area of the pyramid
total_area=0
for i in range(1, int(lay)+1):
    total_area += 4*i*sl**2
total_area += lay**2*sl**2
print(f"You need {total_area:.2f} m^2 of gold foil to cover the pyramid")
